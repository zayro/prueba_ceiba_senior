{
  "uid": "ceiba-services",
  "title": "Ceiba - Servicios y requests",
  "tags": ["ceiba"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Servicio",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_seconds_count, job)", "refId": "job" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "uri",
        "label": "Request (uri)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_seconds_count{job=~\"$job\", uri!~\"/actuator.*\"}, uri)", "refId": "uri" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Por servicio", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "timeseries", "title": "Requests/s por servicio",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}}", "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\", uri!~\"/actuator.*\"}[1m]))" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latencia media por servicio",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}}", "expr": "sum by (job) (rate(http_server_requests_seconds_sum{job=~\"$job\", uri!~\"/actuator.*\"}[1m])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\", uri!~\"/actuator.*\"}[1m]))" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Errores 5xx/s por servicio",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}}", "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\", status=~\"5..\"}[1m]))" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Memoria heap por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}}", "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"})" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Circuit breaker (assistant)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "description": "Estado 1 = activo. Estados: closed, open, half_open.",
      "targets": [ { "refId": "A", "legendFormat": "{{name}} {{state}}", "expr": "resilience4j_circuitbreaker_state{job=~\"$job\"} == 1" } ]
    },
    { "id": 7, "type": "row", "title": "Por request", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 } },
    {
      "id": 8, "type": "timeseries", "title": "Requests/s por endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}} {{method}} {{uri}}", "expr": "sum by (job, method, uri) (rate(http_server_requests_seconds_count{job=~\"$job\", uri=~\"$uri\", uri!~\"/actuator.*\"}[1m]))" } ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Latencia media por endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}} {{method}} {{uri}}", "expr": "sum by (job, method, uri) (rate(http_server_requests_seconds_sum{job=~\"$job\", uri=~\"$uri\", uri!~\"/actuator.*\"}[1m])) / sum by (job, method, uri) (rate(http_server_requests_seconds_count{job=~\"$job\", uri=~\"$uri\", uri!~\"/actuator.*\"}[1m]))" } ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Requests/s por codigo de estado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{job}} {{uri}} {{status}}", "expr": "sum by (job, uri, status) (rate(http_server_requests_seconds_count{job=~\"$job\", uri=~\"$uri\", uri!~\"/actuator.*\"}[1m]))" } ]
    },
    {
      "id": 11, "type": "table", "title": "Resumen por endpoint (ultimos 5 min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "legendFormat": "", "expr": "sum by (job, method, uri) (increase(http_server_requests_seconds_count{job=~\"$job\", uri=~\"$uri\", uri!~\"/actuator.*\"}[5m]))" }
      ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "requests (5m)" } } } ]
    },
    { "id": 12, "type": "row", "title": "Negocio (Triage)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 } },
    {
      "id": 13, "type": "timeseries", "title": "Clasificaciones por nivel",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [ { "refId": "A", "legendFormat": "{{level}}", "expr": "sum by (level) (increase(triage_classifications_total[5m]))" } ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Escalamientos por SLA",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [ { "refId": "A", "legendFormat": "escalamientos", "expr": "sum(increase(triage_escalations_total[5m]))" } ]
    }
  ]
}
