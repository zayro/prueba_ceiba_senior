# Copy to .env and replace both values before exposing the services.
API_KEY=replace-with-a-random-api-key
# Optional for startup; a valid Google AI Studio key is required for RAG queries.
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
RAG_SIMILARITY_THRESHOLD=0.82
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
DB_PASSWORD=replace-with-a-random-database-password
TRIAGE_HOST_PORT=18080
TRIAGE_SCHEDULER_DELAY_MS=10000
