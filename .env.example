# Copy to .env and replace both values before exposing the services.
API_KEY=replace-with-a-random-api-key
LLM_API_KEY=replace-with-google-ai-studio-api-key
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
RAG_SIMILARITY_THRESHOLD=0.82
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
DB_PASSWORD=replace-with-a-random-database-password
TRIAGE_SCHEDULER_DELAY_MS=10000
